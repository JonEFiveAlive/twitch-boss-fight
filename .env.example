# Copy this file to ".env" and fill in your own values. Never commit the real .env file.

# --- From your registered Twitch application (https://dev.twitch.tv/console) ---
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret

# --- Obtained by running: npm run get-token (one-time setup) ---
# See scripts/get-twitch-token.js for instructions. Once you have this, the
# server refreshes its own access token automatically — you should not need
# to touch this again unless it's revoked.
TWITCH_REFRESH_TOKEN=

# Must exactly match a redirect URI registered on your Twitch application.
# Only used by scripts/get-twitch-token.js during one-time setup.
TWITCH_REDIRECT_URI=http://localhost:3001/oauth/callback

# The Twitch account the bot logs in as (can be your own account or a separate bot account)
TWITCH_BOT_USERNAME=your_bot_username

# The channel the bot should join and read chat from (your channel name, lowercase, no #)
TWITCH_CHANNEL=your_channel_name

# Port for the local web server that serves the overlay to OBS
PORT=3000
